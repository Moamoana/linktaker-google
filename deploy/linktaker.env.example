# Setelan lokal untuk run-linktaker.sh.
#
# Cara pakai:
#     cp deploy/linktaker.env.example deploy/linktaker.env
#     nano deploy/linktaker.env
#
# deploy/linktaker.env di-.gitignore, jadi isinya milik mesin ini saja dan
# tidak pernah bentrok saat `git pull`.
#
# Bentuk `: "${NAMA:=nilai}"` berarti "pakai nilai ini kalau belum diset".
# Itu yang membuat env var di depan perintah tetap menang:
#     ENGINE=bing ./deploy/run-linktaker.sh
# tetap memakai bing meski file ini menulis google.
#
# Hapus tanda # di depan baris yang ingin diaktifkan.


# --- Apa yang di-crawl -----------------------------------------------------

# google | yahoo | bing | all
#: "${ENGINE:=all}"

# web = tab Semua, nws = tab Berita, both = keduanya
#: "${MODE:=both}"

# latest | relevance
#: "${SORT:=latest}"

# Rentang tanggal. Relatif (1d, w, 2w, 3m, 1y) atau tanggal pasti (2026-08-18).
# Bentuk relatif dihitung ulang tiap run, jadi jendelanya ikut bergeser.
#: "${DATE_FROM:=1d}"
#: "${DATE_UNTIL:=today}"

# Halaman hasil per keyword. Makin besar makin rawan CAPTCHA.
#: "${MAX_PAGES:=5}"

# Negara yang dicari, mis. my / malaysia / singapura
#: "${GEO:=}"

# Proxy, mis. http://user:pass@host:2570
#: "${PROXY:=}"


# --- Jendela browser & CAPTCHA ---------------------------------------------

# 1 = pakai jendela sepanjang run. Butuh desktop (atau xvfb).
#: "${HEADED:=0}"

# skip  = halaman yang kena CAPTCHA dilewati — untuk run terjadwal
# headed = buka jendela supaya bisa diselesaikan orang — untuk run yang ditunggui
#: "${ON_CAPTCHA:=skip}"


# --- Kirim hasil ke submit_batch -------------------------------------------

# 0 = matikan pengiriman; hasil crawl tetap ditulis ke hasil/ seperti biasa.
#: "${SUBMIT_ENABLED:=1}"

# Endpoint tujuan.
#: "${SUBMIT_URL:=http://103.191.17.47:8001/submit_batch/}"

# Jumlah link per satu POST. Server menolak batch di atas 100 URL.
#: "${SUBMIT_BATCH_SIZE:=100}"

# Percobaan per batch sebelum link masuk antrean, dan batas waktu per POST.
#: "${SUBMIT_RETRIES:=3}"
#: "${SUBMIT_TIMEOUT:=30}"

# Berapa lama sebuah link diingat sebagai "sudah dikirim", dalam hari.
# Selama masih diingat, link yang sama tidak dikirim ulang meski muncul lagi
# di run berikutnya.
#: "${SUBMIT_KEEP_DAYS:=30}"

# Batas jumlah link yang boleh menumpuk di antrean saat server mati.
#: "${SUBMIT_QUEUE_MAX:=20000}"

# Lokasi riwayat kirim & antrean. Default: state/ di dalam folder project.
#: "${SUBMIT_STATE_DIR:=$APP_DIR/state}"


# --- Lain-lain -------------------------------------------------------------

# Umur maksimum file hasil dan log, dalam hari.
#: "${KEEP_DAYS:=14}"

# Interpreter Python. Default sudah menunjuk ke .venv di dalam folder project,
# jadi biasanya tidak perlu diubah.
#: "${PYTHON_BIN:=$APP_DIR/.venv/bin/python}"
