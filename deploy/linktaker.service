[Unit]
Description=LinkTaker crawl (sekali jalan)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/linktaker-google
ExecStart=%h/linktaker-google/deploy/run-linktaker.sh
# Satu run bisa lama kalau --max-pages besar; bunuh kalau lewat 2 jam supaya
# tidak menumpuk dengan jadwal berikutnya.
TimeoutStartSec=7200

# Ubah di sini kalau mau parameter lain (lihat run-linktaker.sh).
Environment=PYTHON_BIN=%h/linktaker-google/.venv/bin/python
Environment=ENGINE=all
Environment=MODE=both
Environment=SORT=latest
Environment=DAYS_BACK=1
Environment=MAX_PAGES=5
# Environment=GEO=malaysia
# Environment=PROXY=http://user:pass@host:2570
