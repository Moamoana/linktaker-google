# Script dan unit systemd dieksekusi di Linux — CRLF membuat shebang gagal
# dengan "bad interpreter", jadi line ending dipaksa LF apa pun platform
# tempat repo ini di-clone.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.py            text eol=lf
*.js            text eol=lf

# Sourced oleh bash (deploy/linktaker.env) dan dibaca di Linux — CRLF membuat
# nilai variabel membawa carriage return di ujungnya.
*.example       text eol=lf
*.md            text eol=lf
